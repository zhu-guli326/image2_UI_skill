{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhu-guli326.github.io/image2_UI_skill/schemas/asset-role.schema.json",
  "title": "Image2 UI Asset Role",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "renderer", "placement"],
  "properties": {
    "role": {
      "enum": [
        "code-ui",
        "graphic-primitive",
        "background-plate",
        "cutout-subject",
        "inline-photo",
        "generated-clean"
      ]
    },
    "renderer": { "enum": ["code", "image2", "project"] },
    "placement": { "enum": ["code", "background", "layered", "container"] },
    "generationScope": { "enum": ["none", "asset-only"] },
    "needsCutout": { "type": "boolean" },
    "generationBackground": {
      "enum": ["transparent", "solid-color", "green-screen", "full-scene", "not-applicable"]
    },
    "keyingMode": { "enum": ["native-alpha", "background-removal", "chroma-key", "none"] },
    "solidBackgroundColor": { "type": "string", "minLength": 1 },
    "requiresTransparency": { "type": "boolean" },
    "participatesInOverlap": { "type": "boolean" },
    "containsCodeOwnedText": { "type": "boolean" },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "role": { "enum": ["code-ui", "graphic-primitive"] } }, "required": ["role"] },
      "then": {
        "properties": {
          "renderer": { "const": "code" },
          "placement": { "const": "code" },
          "generationScope": { "const": "none" },
          "needsCutout": { "const": false },
          "generationBackground": { "const": "not-applicable" },
          "keyingMode": { "const": "none" }
        }
      }
    },
    {
      "if": { "properties": { "role": { "const": "cutout-subject" } }, "required": ["role"] },
      "then": {
        "properties": {
          "placement": { "const": "layered" },
          "needsCutout": { "const": true },
          "requiresTransparency": { "const": true },
          "generationScope": { "const": "asset-only" },
          "generationBackground": { "enum": ["transparent", "solid-color", "green-screen"] },
          "keyingMode": { "enum": ["native-alpha", "background-removal", "chroma-key"] }
        },
        "required": ["needsCutout", "requiresTransparency", "generationScope", "generationBackground", "keyingMode"]
      }
    },
    {
      "if": {
        "properties": {
          "role": { "const": "background-plate" },
          "renderer": { "const": "image2" }
        },
        "required": ["role", "renderer"]
      },
      "then": {
        "properties": {
          "placement": { "const": "background" },
          "generationScope": { "const": "asset-only" },
          "needsCutout": { "const": false },
          "generationBackground": { "const": "full-scene" },
          "keyingMode": { "const": "none" }
        },
        "required": ["needsCutout", "generationBackground", "keyingMode"]
      }
    },
    {
      "if": {
        "properties": {
          "role": { "const": "inline-photo" },
          "renderer": { "const": "image2" }
        },
        "required": ["role", "renderer"]
      },
      "then": {
        "properties": {
          "placement": { "const": "container" },
          "generationScope": { "const": "asset-only" },
          "needsCutout": { "const": false },
          "generationBackground": { "const": "full-scene" },
          "keyingMode": { "const": "none" }
        },
        "required": ["needsCutout", "generationBackground", "keyingMode"]
      }
    },
    {
      "if": { "properties": { "renderer": { "const": "image2" } }, "required": ["renderer"] },
      "then": {
        "properties": { "generationScope": { "const": "asset-only" } },
        "required": ["generationScope", "needsCutout", "generationBackground", "keyingMode"]
      }
    },
    {
      "if": { "properties": { "generationBackground": { "const": "green-screen" } }, "required": ["generationBackground"] },
      "then": { "properties": { "keyingMode": { "const": "chroma-key" } } }
    },
    {
      "if": { "properties": { "generationBackground": { "const": "transparent" } }, "required": ["generationBackground"] },
      "then": { "properties": { "keyingMode": { "const": "native-alpha" } } }
    },
    {
      "if": { "properties": { "generationBackground": { "const": "solid-color" } }, "required": ["generationBackground"] },
      "then": { "required": ["solidBackgroundColor"] }
    },
    {
      "if": { "properties": { "role": { "enum": ["background-plate", "cutout-subject", "inline-photo", "generated-clean"] } }, "required": ["role"] },
      "then": { "properties": { "containsCodeOwnedText": { "const": false } } }
    }
  ]
}
