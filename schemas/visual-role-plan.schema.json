{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhu-guli326.github.io/image2_UI_skill/schemas/visual-role-plan.schema.json",
  "title": "Image2 UI Visual Role Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "workflow", "elements"],
  "properties": {
    "version": { "const": 1 },
    "workflow": { "enum": ["recreate", "redesign", "create"] },
    "reference": { "type": "string" },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assetRole", "overlayRole"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "referenceRegion": {
            "type": "array",
            "prefixItems": [
              { "type": "number" },
              { "type": "number" },
              { "type": "number", "exclusiveMinimum": 0 },
              { "type": "number", "exclusiveMinimum": 0 }
            ],
            "minItems": 4,
            "maxItems": 4
          },
          "assetId": { "type": "string", "minLength": 1 },
          "assetRole": { "$ref": "asset-role.schema.json" },
          "overlayRole": { "$ref": "overlay-role.schema.json" },
          "semanticPriority": { "enum": ["primary", "secondary", "supporting", "decorative"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
