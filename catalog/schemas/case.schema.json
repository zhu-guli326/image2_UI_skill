{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image2 UI case",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "style", "category", "referenceImage", "prompt", "summary", "bestFor", "tags", "brandProfileIds"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "style": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "referenceImage": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "bestFor": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "brandProfileIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
  }
}
