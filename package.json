{
  "name": "image2-ui-skill",
  "version": "0.1.0",
  "description": "A reusable Harness/Skill for turning visual references or product intent into production-shaped UI workflows.",
  "type": "module",
  "bin": {
    "image2-ui": "scripts/image2-ui"
  },
  "files": [
    "README.md",
    "SKILL.md",
    "PRODUCTION.md",
    "references/",
    "scripts/image2-ui",
    "scripts/image2_asset.py",
    "scripts/image2_orchestrate.mjs",
    "scripts/workflow_state_machine.mjs",
    "scripts/ui_compare.mjs",
    "scripts/ui_loop.mjs",
    "scripts/ui_output_audit.mjs",
    "scripts/ui_output_audit_core.mjs",
    "scripts/ui_harness_guard.mjs",
    "scripts/ui_harness_guard_v2.mjs",
    "scripts/ui_asset_plan_guard.mjs",
    "scripts/ui_reference_asset_guard.mjs",
    "scripts/ui_recreate_image2_policy_guard.mjs",
    "scripts/ui_visual_role_guard.mjs",
    "scripts/ui_freeform_layout_guard.mjs",
    "runtime/",
    "schemas/",
    "assets/readme/hero.png"
  ],
  "scripts": {
    "test": "node --test",
    "doctor": "node scripts/image2-ui doctor",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20",
    "python": ">=3.10"
  },
  "keywords": [
    "codex",
    "image2",
    "image-to-ui",
    "ui",
    "harness",
    "agent"
  ],
  "license": "MIT"
}
