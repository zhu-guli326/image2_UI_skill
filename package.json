{
  "name": "image2-ui-skill",
  "version": "0.1.0",
  "description": "Production-grade Codex skill and CLI toolkit for turning UI references into code-rendered demos with image2 bitmap assets.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhu-guli326/image2_UI_skill.git"
  },
  "bugs": {
    "url": "https://github.com/zhu-guli326/image2_UI_skill/issues"
  },
  "homepage": "https://github.com/zhu-guli326/image2_UI_skill#readme",
  "bin": {
    "image2-ui": "scripts/image2-ui"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "PRODUCTION.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "quality-baseline.json",
    "launcher.html",
    "launcher.css",
    "launcher.js",
    "library.html",
    "library.css",
    "library.js",
    "library-search.mjs",
    "brands.html",
    "brands.css",
    "brands.js",
    "catalog/",
    "learn.html",
    "learn.css",
    "learn.js",
    "vocabulary.html",
    "vocabulary.css",
    "vocabulary.js",
    "vocabulary-data.js",
    "reference.html",
    "reference.js",
    "markdown.html",
    "markdown.css",
    "markdown.js",
    "skills.html",
    "skills.css",
    "skills.js",
    "analytics.config.js",
    "analytics.js",
    "references/motion-system.md",
    "references/",
    "scripts/",
    "assets/readme/hero.png"
  ],
  "scripts": {
    "test": "node --test",
    "catalog:build": "node scripts/build_catalog.mjs",
    "catalog:check": "node scripts/build_catalog.mjs --check",
    "validate:demo": "node scripts/ui_output_audit.mjs demo/generated-home-ui",
    "validate:demo:static": "node scripts/ui_output_audit.mjs demo/generated-home-ui --no-browser",
    "validate:all": "node scripts/validate_demos.mjs",
    "validate:all:static": "node scripts/validate_demos.mjs --no-browser",
    "capture:library": "node scripts/capture_library_posters.mjs",
    "capture:library:effects": "node scripts/capture_library_effect_images.mjs",
    "audit:library": "node scripts/audit_library.mjs",
    "audit:library:browser": "node scripts/audit_library_browser.mjs",
    "audit:brands:browser": "node scripts/audit_brands_browser.mjs",
    "audit:demo": "npm audit --prefix demo/smart-home-ui-v2 --audit-level=high",
    "doctor": "node scripts/image2-ui doctor",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20",
    "python": ">=3.10"
  },
  "keywords": [
    "codex",
    "image2",
    "image-to-ui",
    "ui-generation",
    "design-to-code"
  ]
}
